flowchart TB
  U["用户结果 · 范围 · 明确偏好"] --> G["目标版本与完成依据"]
  subgraph Reasoning["认知与规划"]
    G --> C["上下文与最新节点"] --> H["事实 · 假设 · 决定性未知"]
    H --> P["预习并保存预测"] --> A["选择行动与失败后继"]
  end
  subgraph Host["执行宿主"]
    A --> T["真实模型回合与获准工具"] --> O["产物 · 失败 · 原始回执"]
    O --> V["独立的完整任务检查"]
  end
  subgraph Learning["Markdown 学习记忆"]
    M["项目 memory / context / nodes"]
    E["带来源与范围的经验"]
    B["行为证据 / 标签 / 纠正"]
    R["日报 / 周报 / 周一预习"]
    M --> E --> R
    B --> R
  end
  V --> J{"预测是否得到支持"}
  J -->|是| M
  J -->|存在缺口| L["诊断 · 补课 · 复测"] --> P
  E --> C
  R --> P
  subgraph Improvement["有界实验"]
    X["原版 + 通用候选 + 领域候选"] --> Q["完整任务质量 / 耗时 / 成本"]
    Q --> S["组合并另跑后继"] --> F["限定采用 / 回退"]
    F --> E
  end
  L --> X
  F --> A
  M --> N{"下个有效条件"}
  N -->|未来用途| W["宿主调度：登记 → 触发 → 检查 → 停止"]
  N -->|交接| K["责任方 + 修订 + 产物核对"] --> C
  N -->|完成| Z["总结 · 可复用经验 · 最终验收"]
  N -->|用户取舍| U
  W --> C
