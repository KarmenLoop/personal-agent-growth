flowchart TD
    A["逐项读取跳过条件与正文"] --> B{"缺失条件"}
    B --> C["产品可用性决策"]
    B --> D["服务输入或依赖"]
    B --> E["原生平台"]
    C --> F["证明公开拒绝与零传输调用"]
    F --> G["显式离线传输和真实适配器及工具"]
    D --> H["核实接口、版本和输入身份"]
    H --> I["实跑服务与隔离反例"]
    E --> J["定位用户指定的 Windows 虚拟机"]
    J --> K{"来宾与存储是否可用"}
    K -- 否 --> L["保留 NOT_RUN 节点并请求缺失前提"]
    K -- 是 --> M["原守卫与真实 ACL 及回退检查"]
    G --> N["冻结版本执行已配置全量"]
    I --> N
    M --> R["来宾回执、输出哈希与结果包"]
    R --> S["宿主核对源码身份、原始输出和用例名称"]
    S --> O
    N --> O["逐项对账原名称并保留失败尝试"]
    L --> O
    O --> P["发布准确范围并沉淀 Markdown 经验"]
